# This file excludes paths from the Docker build context.
#
# By default, Docker's build context includes all files (and folders) in the
# current directory. Even if a file isn't copied into the container it is still sent to
# the Docker daemon.
#
# There are multiple ways to filter files from the build context:
#
#  ✓ Listing them in this file
#
# We prefer listing them explicitly here, so it's clear what's included and
# excluded. For more info see the docs:
# https://docs.docker.com/engine/reference/builder/#dockerignore-file

# Ignore git, but keep git HEAD and refs available
.git
.gitignore

# Common development/test artifacts
/cover/
/doc/
/test/
/tmp/
.elixir_ls
*.ez

# Mix artifacts
/_build/
/deps/
*.ez

# Generated on crash by the VM
erl_crash.dump

# Static artifacts - these should be built inside the Docker image
/assets/node_modules/
/priv/static/assets/
/priv/static/cache_manifest.json

# Files matching config/*.local.exs pattern
config/*.local.exs

# Hidden files
.env*

# Docker artifacts
.dockerignore
Dockerfile

# IDE / editor
.vscode/
.idea/
.DS_Store
